# ============================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Copy the relevant section into your hosting provider's
# environment variable settings.
# DO NOT commit real secrets. This file documents the contract.
# ============================================================


# ============================================================
# Railway: API service (services/api)
# Railway → gujarati-api service → Variables
# ============================================================

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Railway Postgres — Railway → PostgreSQL → Variables / Public URL
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway

# Upstash Redis — Console → Redis → Connect → .env tab
REDIS_URL=rediss://default:PASSWORD@HOSTNAME.upstash.io:6379

# JWT — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-32-byte-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Cookie signing
COOKIE_SECRET=replace-with-32-byte-random-string

# CORS — must include your exact Vercel deployment URL
CORS_ORIGINS=https://your-app.vercel.app

# Supabase Storage — Dashboard → Settings → API → service_role key
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Email / OTP — use Resend, Postmark, or SMTP relay
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASS=your-smtp-api-key
EMAIL_FROM=no-reply@yourdomain.com

# Optional tuning
OTP_EXPIRY_SECONDS=600
BCRYPT_ROUNDS=12
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=10


# ============================================================
# Vercel: web app (apps/web)
# Vercel → Project → Settings → Environment Variables
# ============================================================

# Server-side only proxy target — NOT exposed to the browser
API_BASE_URL=https://gujarati-api.up.railway.app/api/v1


# ============================================================
# Railway: Worker service (services/worker)
# Share DATABASE_URL and REDIS_URL from the API service.
# ============================================================

NODE_ENV=production
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway
REDIS_URL=rediss://default:PASSWORD@HOSTNAME.upstash.io:6379
